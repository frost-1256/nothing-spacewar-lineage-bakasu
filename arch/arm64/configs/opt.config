# Performance / latency / battery tuning (additive, ABI-neutral)
# Network: BBR + fair queueing for lower latency and better throughput
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y

# Power/perf balance: schedutil is the WALT-aware governor on this tree
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y

# Memory: opt-in huge pages only (no khugepaged pressure without madvise)
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# Storage: allow f2fs transparent compression (mount option decides usage)
CONFIG_F2FS_FS_COMPRESSION=y
